# Copy this file to ".env". The app works fully WITHOUT any key: "Fast" mode
# (extractive) needs nothing, and "Thinking" mode auto-falls back to Fast when
# no provider is reachable.
#
# "Thinking" mode talks to any OpenAI-compatible provider. Pick ONE option:

# ── Option 1: FREE, no signup (good for the demo) ────────────────────────────
# LLM7.io is a community OpenAI-compatible proxy — no key, no account. Fine for
# the bundled sample docs; avoid sending real/sensitive documents through it.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.llm7.io/v1
OPENAI_MODEL=default
OPENAI_API_KEY=unused

# ── Option 2: free first-party tiers (better for real documents) ─────────────
# Cohere  — email/Google sign-in, no phone, no card. https://dashboard.cohere.com/api-keys
#   OPENAI_BASE_URL=https://api.cohere.ai/compatibility/v1   OPENAI_MODEL=command-r7b-12-2024
# Mistral — SMS verify, no card. https://console.mistral.ai (pick "Experiment for free")
#   OPENAI_BASE_URL=https://api.mistral.ai/v1                OPENAI_MODEL=mistral-small-latest
# For either: keep LLM_PROVIDER=openai and set OPENAI_API_KEY to the issued key.

# ── Option 3: paid Anthropic (Claude) or real OpenAI ─────────────────────────
# Set LLM_PROVIDER=anthropic + an sk-ant-... key, or keep openai with a real
# sk-... key and OPENAI_BASE_URL empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Retrieval tuning
TOP_K=4
SCORE_THRESHOLD=0.12
