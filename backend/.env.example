# Copy this file to ".env" to enable "Thinking" mode. The app works fully
# WITHOUT any key: "Fast" mode (extractive) needs nothing, and "Thinking" mode
# automatically falls back to Fast when no key is present.

# Provider for Thinking mode: "anthropic" (Claude) or "openai"
LLM_PROVIDER=anthropic

# API keys (only needed for Thinking mode). Leave blank to stay on Fast.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models used by Thinking mode (Sonnet 4.6 supports adaptive thinking).
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Retrieval tuning
TOP_K=4
SCORE_THRESHOLD=0.12
