# Copy this file to ".env" and fill in values if you want LLM-synthesized answers.
# The app works fully WITHOUT any keys using the built-in extractive answer mode.

# Answer mode: "extractive" (default, no API needed) or "llm"
ANSWER_MODE=extractive

# LLM provider when ANSWER_MODE=llm: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# API keys (only needed for ANSWER_MODE=llm)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names (sensible defaults are used if left blank)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Retrieval tuning
TOP_K=4
SCORE_THRESHOLD=0.12
